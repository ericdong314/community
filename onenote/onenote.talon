app.name: Microsoft OneNote
mode: command
-
settings():
    key_wait = 20.0
    # speech.timeout = 0.1

wintry shower:
    key('alt-=')
sunny spell:
    key('alt-=')
big oh:
    insert('O')
small oh:
    insert('o')
big omega:
    insert('bigomega')
big theta:
    insert('bigtheta')
infinity:
    insert('infty')
fee:
    insert('\phi ')
at most:
    insert('<=')
at least:
    insert('>=')
goes to:
    insert('->')
parentheses:
    insert('()')


fancy pants:
    insert('\\tilde  ')
factorial:
    insert('!')
el gee of:
    insert('lgof')
to the power of:
    insert('^')
the square root of:
    insert('sqrtof')
of:
    insert('of')
over:
    insert('over')
with argument:
    insert('()')
logarithm:
    insert('lg')    
the absolute value of:
    insert('||')
    key(left)
ceiling function:
    insert('ceilingof')
floor function:
    insert('floorof')

